# C64Scene SDK M1.3 - VICE monitor commands
# Load labels generated by 64tass before using symbolic breakpoints.
#
# Typical use:
#   x64sc -moncommands tools/vice/double-irq.mon -autostart build/double-irq.prg
#
# The labels file can be imported separately depending on VICE version.
# This script keeps addresses explicit so qualification does not depend on
# monitor label syntax/version.

break $080d
watch store $d020
